# ─── API Keys ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=doc-chatbot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
TAVILY_API_KEY=your-tavily-api-key-here
# Default: require the authenticated Tavily provider; set false only for development fallback.
REQUIRE_AUTHENTICATED_WEB_SEARCH=true

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# ─── Database ────────────────────────────────────────────
DATABASE_URL=sqlite:///./storage/app.db

# ─── Upload limits ───────────────────────────────────────
UPLOAD_MAX_MB=25

# ─── LLM defaults ───────────────────────────────────────
LLM_PRIMARY_MODEL=gemini-3.8-flash
# Comma-separated; models out of quota or retired are skipped automatically.
LLM_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
LLM_MAX_RETRIES=3

# ─── Templates ──────────────────────────────────────────
DEFAULT_DOCX_TEMPLATE_PATH=data/sample_templates/Company_Proposal.docx
DEFAULT_PPTX_TEMPLATE_PATH=data/sample_templates/Green Cream Simple Aesthetic Watercolor Presentation.pptx

# Optional: use an already-installed pptx-masters CLI to extract a design guide.
PPTX_MASTERS_ENABLED=0

# ─── Scholarly research & images (optional keys) ───────
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# RESEARCH_CONTACT_EMAIL=you@example.org
# ACADEMIC_SOURCES=openalex,semantic_scholar,arxiv
# IMAGES_ENABLED=true
# IMAGE_PROVIDER=auto
# PEXELS_API_KEY=

# ─── Optional settings (defaults shown) ─────────────────
# LLM_PROVIDER=gemini                  # gemini | openai_compat | fake
# Model specs may name a provider: LLM_PRIMARY_MODEL=openai_compat:llama3.1
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1   # Ollama, vLLM, LM Studio, OpenRouter, OpenAI...
# OPENAI_COMPAT_API_KEY=
# LLM_TEMPERATURE=0.3
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_NATIVE_SCHEMA=false              # also send the provider's native JSON-schema constraint
# EMBEDDING_PROVIDER=gemini            # gemini | openai_compat | hash (offline)
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768             # must equal the Pinecone index dimension
# VECTOR_STORE=auto                    # auto (pinecone if key set) | pinecone | local
# PINECONE_API_VERSION=2026-07
# PPTX_MASTERS_COMMAND=pptx-masters
# PPTX_MASTERS_ARGS={input} --output {output_dir}
# STORAGE_DIR=./storage
# APP_ENV=dev                          # dev | test | prod (prod refuses the placeholder JWT_SECRET)
# LIBREOFFICE_PATH=
# LOG_LEVEL=INFO
